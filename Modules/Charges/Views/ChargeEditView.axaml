<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GestionCommerciale.Modules.Charges.ViewModels"
             xmlns:m="using:GestionCommerciale.Modules.Charges.Models"
             x:Class="GestionCommerciale.Modules.Charges.Views.ChargeEditView"
             x:Name="ChargeEditRoot"
             x:DataType="vm:ChargeEditViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding BtnBack}" Command="{Binding BackCommand}"/>
        <Button Classes="primary" Content="{Binding BtnSave}" Command="{Binding SaveCommand}"/>
        <Button Content="{Binding BtnDelete}" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}"/>
      </StackPanel>

      <Grid ColumnDefinitions="*,16,320">
        <Border Grid.Column="0" Background="{DynamicResource CourseraSurfaceBrush}"
                BorderBrush="{DynamicResource CourseraBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16"/>

            <TextBlock Text="{Binding LblType}" Opacity="0.7"/>
            <ComboBox MinWidth="220" HorizontalAlignment="Left"
                      ItemsSource="{Binding TypesDisponibles}"
                      SelectedItem="{Binding SelectedType, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="m:TypeCharge">
                  <TextBlock Text="{Binding Nom}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="{Binding LblDate}" Opacity="0.7"/>
            <DatePicker SelectedDate="{Binding Date}" HorizontalAlignment="Left"/>

            <TextBlock Text="{Binding LblLibelle}" Opacity="0.7"/>
            <TextBox Watermark="{Binding WmLibelle}" Text="{Binding Libelle, Mode=TwoWay}"/>

            <TextBlock Text="{Binding LblTtc}" Opacity="0.7"/>
            <NumericUpDown Width="140" HorizontalAlignment="Left"
                           Minimum="0" FormatString="N2"
                           Value="{Binding MontantTtc, Mode=TwoWay}"/>

            <TextBlock Text="{Binding LblNote}" Opacity="0.7"/>
            <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"
                     Text="{Binding Note, Mode=TwoWay}"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource CourseraSurfaceBrush}"
                BorderBrush="{DynamicResource CourseraBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <TextBlock Grid.Row="0" Text="{Binding LblTypesPanel}" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
              <TextBox MinWidth="140" Watermark="{Binding WmNewType}" Text="{Binding NewTypeNom, Mode=TwoWay}"/>
              <Button Content="{Binding BtnAddType}" Command="{Binding AddTypeCommand}"/>
            </StackPanel>
            <ListBox Grid.Row="2" ItemsSource="{Binding TypesGestion}" SelectedItem="{Binding SelectedTypeGestion}"
                     BorderBrush="{DynamicResource CourseraBorderBrush}" BorderThickness="1" CornerRadius="8">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="m:TypeCharge">
                  <Border Background="Transparent" Padding="0">
                    <Border.ContextMenu>
                      <ContextMenu Opening="OnTypeContextMenuOpening">
                        <MenuItem Header="{Binding #ChargeEditRoot.((vm:ChargeEditViewModel)DataContext).MenuEditType}"
                                  Command="{Binding #ChargeEditRoot.((vm:ChargeEditViewModel)DataContext).EditTypeCommand}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="{Binding #ChargeEditRoot.((vm:ChargeEditViewModel)DataContext).MenuDeleteType}"
                                  Command="{Binding #ChargeEditRoot.((vm:ChargeEditViewModel)DataContext).DeleteTypeCommand}"
                                  CommandParameter="{Binding}"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                      <TextBlock Grid.Column="0" Text="{Binding Nom}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Actif, Converter={StaticResource BoolActifLabelConverter}}"
                                 Opacity="0.75" Margin="8,0,0,0"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                    Content="{Binding BtnToggleActif}" Command="{Binding ToggleTypeActifCommand}"/>
          </Grid>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
